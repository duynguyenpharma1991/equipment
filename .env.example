# Supabase (required) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL (canonical URLs, sitemap, Open Graph). Set to the Vercel/production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the footer / contact page when no email is set in the admin settings
NEXT_PUBLIC_CONTACT_EMAIL=

# NOTE: never put the Supabase secret / service_role key in a NEXT_PUBLIC_* variable.
# The app does not need it at runtime (all writes go through RLS as the signed-in admin).
